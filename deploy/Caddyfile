:80 {
  encode zstd gzip

  root * /srv/site

  redir /index / 301
  redir /index.html / 301

  @html_ext path_regexp html ^/(.+)\.html$
  redir @html_ext /{re.html.1} 301

  @root path /
  rewrite @root /index

  @recipe_share path /recipe-share/*
  rewrite @recipe_share /recipe-share

  try_files {path} {path}.html

  @html_pages path / /404 /agb /datenschutz /hinweise-disclaimer /impressum /index /ki-hinweise /konto-loeschen /recipe-share /recipe-share/*
  header @html_pages >Content-Type "text/html; charset=utf-8"

  handle_errors {
    @404 expression `{http.error.status_code} == 404`
    rewrite @404 /404
    header @404 >Content-Type "text/html; charset=utf-8"
    file_server
  }

  file_server {
    hide .git
    hide deploy
    hide README.md
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy camera=(), microphone=(), geolocation=()
  }
}
