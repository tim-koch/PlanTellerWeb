---
import Icon from "./Icon.astro";

interface Props {
  icon: string;
  title: string;
  status?: "live" | "planned";
}

const { icon, title, status } = Astro.props;
---

<article
  class="surface-card group h-full p-6 transition duration-300 hover:-translate-y-1"
  data-reveal
>
  <div
    class="mb-5 grid size-12 place-items-center rounded-2xl bg-[var(--sage-soft)] text-[var(--brand-strong)]"
  >
    <Icon name={icon} class="size-7" />
  </div>
  {
    status && (
      <span
        class:list={[
          "mb-3 inline-flex rounded-full px-2.5 py-1 text-[0.68rem] font-extrabold tracking-wide uppercase",
          status === "live"
            ? "bg-[var(--sage-soft)] text-[var(--brand-strong)]"
            : "bg-[var(--surface-strong)] text-[var(--muted)]",
        ]}
      >
        {status === "live" ? "Schon dabei" : "In Entwicklung"}
      </span>
    )
  }
  <h3 class="text-xl font-extrabold">{title}</h3>
  <div class="mt-3 text-sm text-[var(--muted)]"><slot /></div>
</article>
