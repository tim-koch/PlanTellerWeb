---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "quiet";
  icon?: string;
  class?: string;
}

const { href, variant = "primary", icon, class: className } = Astro.props;
const variants = {
  primary:
    "bg-[var(--brand-strong)] text-[var(--inverse)] border-[var(--brand-strong)] hover:-translate-y-0.5 hover:shadow-[var(--shadow-float)]",
  secondary:
    "bg-[var(--surface)] text-[var(--ink)] border-[var(--line)] hover:border-[var(--brand)] hover:text-[var(--brand)]",
  quiet:
    "bg-transparent text-[var(--brand)] border-transparent hover:bg-[var(--sage-soft)]",
};
---

<a
  class:list={[
    "inline-flex min-h-12 items-center justify-center gap-2 rounded-full border px-5 py-2.5 text-sm font-extrabold no-underline transition duration-200",
    variants[variant],
    className,
  ]}
  href={href}
>
  <slot />
  {icon && <Icon name={icon} class="size-5" />}
</a>
