---
import { Picture } from "astro:assets";

type ImageSource = (typeof import("../assets/app/light/hero.png"))["default"];

export interface Props {
  light: ImageSource;
  dark?: ImageSource;
  alt: string;
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
  zoomable?: boolean;
}

const {
  light,
  dark = light,
  alt,
  widths,
  sizes,
  priority = false,
  class: className,
} = Astro.props;
const shared = {
  widths,
  sizes,
  formats: ["avif", "webp"] as ("avif" | "webp")[],
  fallbackFormat: "webp" as const,
  quality: 65,
  loading: priority ? ("eager" as const) : ("lazy" as const),
  decoding: "async" as const,
};
---

<span class="block dark:hidden" data-theme-picture="light">
  <Picture src={light} {alt} {...shared} class={className} />
</span>
<span class="hidden dark:block" data-theme-picture="dark">
  <Picture src={dark} {alt} {...shared} class={className} />
</span>
