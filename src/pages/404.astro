---
import { Picture } from "astro:assets";
import notFoundImage from "../assets/illustrations/404.png";
import Button from "../components/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Seite nicht gefunden – PlanTeller"
  description="Die angeforderte PlanTeller-Seite wurde nicht gefunden."
  canonicalPath="/404"
  noindex
>
  <main class="page-container section-space" id="main-content">
    <section
      class="surface-card mx-auto max-w-4xl overflow-hidden p-6 text-center sm:p-10"
    >
      <Picture
        src={notFoundImage}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 92vw, 800px"
        alt="PlanTeller-Figur neben einer 404-Zahl"
        loading="eager"
        fetchpriority="high"
        class="mx-auto w-full max-w-2xl"
      />
      <h1 class="brand-heading mt-6 text-5xl sm:text-6xl">
        Diese Seite gibt es nicht.
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-[var(--muted)]">
        Der Link ist vielleicht veraltet, falsch kopiert oder die Seite wurde
        verschoben.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <Button href="/">Zur Startseite</Button>
        <Button href="/kontakt?anliegen=fehler" variant="secondary"
          >Fehler melden</Button
        >
      </div>
    </section>
  </main>
</BaseLayout>
