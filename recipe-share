<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PlanTeller Rezeptfreigabe</title>
  <meta name="description" content="Rezeptfreigabe in PlanTeller öffnen und direkt in den Haushalt übernehmen.">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <link rel="canonical" href="https://www.planteller.de/recipe-share">
  <meta property="og:type" content="website">
  <meta property="og:title" content="PlanTeller Rezeptfreigabe">
  <meta property="og:description" content="Rezept in PlanTeller öffnen und übernehmen.">
  <meta property="og:url" content="https://www.planteller.de/recipe-share">
  <meta property="og:image" content="https://www.planteller.de/assets/images/logo.png">
  <link rel="icon" type="image/png" href="/assets/images/logo.png">
  <link rel="apple-touch-icon" href="/assets/images/logo.png">
  <script>try{var s=JSON.parse(localStorage.getItem("planteller-display-settings")||"{}");document.documentElement.dataset.theme=s.theme||"system";document.documentElement.dataset.contrast=s.contrast||"system";document.documentElement.dataset.motion=s.motion||"system";}catch(e){}</script>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .share-wrap {
      max-width: 760px;
      margin: 0 auto;
    }

    .share-card {
      border: 1px solid var(--line);
      background: var(--card);
      border-radius: var(--radius-xl);
      box-shadow: 0 20px 45px rgba(44, 41, 37, 0.08);
      padding: clamp(20px, 4vw, 34px);
      display: grid;
      gap: 14px;
    }

    .code-line {
      border: 1px dashed var(--sage-strong);
      border-radius: var(--radius-lg);
      padding: 14px;
      background: rgba(223, 234, 219, 0.38);
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .hint {
      color: var(--muted);
      margin: 0;
      font-size: 14px;
    }

    .status {
      margin: 0;
      font-size: 14px;
      color: var(--sage-strong);
      min-height: 20px;
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/"><img class="brand-mark" src="/assets/images/logo.png" alt="PlanTeller Logo" width="512" height="512" decoding="async"><span class="logo">PlanTeller</span></a>
    </div>
  </header>

  <main class="legal-page" id="main-content">
    <div class="container share-wrap">
      <a class="back-link" href="/">Zurück zur Startseite</a>
      <section class="share-card" aria-live="polite">
        <h1 style="margin:0;">Rezeptfreigabe</h1>
        <p class="hint">Tippe auf "In App öffnen", damit PlanTeller das Rezept direkt übernehmen kann.</p>

        <div>
          <p class="hint" style="margin-bottom:8px;">Freigabe-Code</p>
          <div id="shareToken" class="code-line">Wird geladen ...</div>
        </div>

        <div class="hero-actions" style="margin-top:6px;">
          <a id="openAppBtn" class="btn btn-primary" href="#">In App öffnen</a>
          <button id="copyBtn" class="btn btn-secondary" type="button">Code kopieren</button>
        </div>

        <p class="hint">Falls die App nicht automatisch öffnet: Code kopieren und in der App unter "Rezepte -> Rezept-Code einlösen" einfügen.</p>
        <p id="status" class="status"></p>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <span>&copy; 2026 PlanTeller - by Telli</span>
      <span>Kontakt: kochbuch_app@outlook.de</span>
    </div>
  </footer>

  <script>
    (function () {
      var tokenEl = document.getElementById('shareToken');
      var openBtn = document.getElementById('openAppBtn');
      var copyBtn = document.getElementById('copyBtn');
      var statusEl = document.getElementById('status');

      function readToken() {
        var url = new URL(window.location.href);
        var queryToken = (url.searchParams.get('token') || '').trim();
        if (queryToken) return queryToken;

        var parts = url.pathname.split('/').filter(Boolean);
        var idx = parts.findIndex(function (part) { return part.toLowerCase() === 'recipe-share'; });
        if (idx >= 0 && parts[idx + 1]) {
          return decodeURIComponent(parts[idx + 1]).trim();
        }

        return '';
      }

      function setStatus(message, isError) {
        statusEl.textContent = message || '';
        statusEl.style.color = isError ? '#b33a3a' : 'var(--sage-strong)';
      }

      var token = readToken();
      if (!token) {
        tokenEl.textContent = 'Kein Freigabe-Code im Link gefunden';
        openBtn.setAttribute('aria-disabled', 'true');
        openBtn.classList.add('btn-secondary');
        openBtn.classList.remove('btn-primary');
        openBtn.removeAttribute('href');
        copyBtn.disabled = true;
        setStatus('Bitte Link erneut aus der App teilen.', true);
        return;
      }

      tokenEl.textContent = token;
      var deepLink = 'planteller://recipe-share?token=' + encodeURIComponent(token);
      openBtn.setAttribute('href', deepLink);

      if (/Android/i.test(navigator.userAgent)) {
        setStatus('Versuche die App automatisch zu öffnen ...', false);
        window.setTimeout(function () {
          window.location.href = deepLink;
        }, 280);
      }

      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(token).then(function () {
          setStatus('Code wurde in die Zwischenablage kopiert.', false);
        }).catch(function () {
          setStatus('Kopieren fehlgeschlagen. Bitte Code manuell markieren.', true);
        });
      });

      openBtn.addEventListener('click', function () {
        setStatus('App wird geöffnet ...', false);
      });
    })();
  </script>
  <script src="/settings.js" defer></script>
</body>
</html>
