  <script>
    (function () {
      const carousel = document.querySelector("[data-carousel]");
      if (!carousel) return;
      const track = carousel.querySelector("[data-track]");
      const slides = Array.from(track.querySelectorAll(".carousel-item"));
      const prev = carousel.querySelector("[data-prev]");
      const next = carousel.querySelector("[data-next]");
      const dotsWrap = document.querySelector("[data-dots]");
      const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll("button")) : [];
      const carouselToggle = document.querySelector("[data-carousel-toggle]");
      const carouselStatus = document.querySelector("[data-carousel-status]");
      const lightbox = document.querySelector("[data-lightbox]");
      const lightboxImage = lightbox ? lightbox.querySelector("[data-lightbox-image]") : null;
      const lightboxStatus = lightbox ? lightbox.querySelector("[data-lightbox-status]") : null;
      const lightboxCloseButtons = lightbox ? Array.from(lightbox.querySelectorAll("[data-lightbox-close]")) : [];
      const lightboxPrev = lightbox ? lightbox.querySelector("[data-lightbox-prev]") : null;
      const lightboxNext = lightbox ? lightbox.querySelector("[data-lightbox-next]") : null;
      let lastZoomButton = null;
      let index = 0;
      let timer = null;
      let isPaused = true;

      function setActive(nextIndex) {
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const isCurrent = i === index;
          slide.classList.toggle("is-active", isCurrent);
          slide.hidden = !isCurrent;
        });
        dots.forEach((dot, i) => {
          const isCurrent = i === index;
          dot.classList.toggle("is-active", isCurrent);
          dot.setAttribute("aria-current", String(isCurrent));
        });
        if (carouselStatus) {
          carouselStatus.textContent = "Bild " + (index + 1) + " von " + slides.length;
        }
        if (lightboxStatus) {
          lightboxStatus.textContent = "Bild " + (index + 1) + " von " + slides.length;
        }
      }

      function resetTimer() {
        if (timer) window.clearInterval(timer);
        if (isPaused) return;
        timer = window.setInterval(function () {
          setActive(index + 1);
        }, 7000);
      }

      function setPaused(paused) {
        isPaused = paused;
        if (carouselToggle) {
          carouselToggle.setAttribute("aria-pressed", String(isPaused));
          carouselToggle.textContent = isPaused ? "Automatisch wechseln starten" : "Automatisch wechseln pausieren";
        }
        if (carouselStatus) {
          carouselStatus.setAttribute("aria-live", isPaused ? "polite" : "off");
        }
        resetTimer();
      }

      prev.addEventListener("click", function () {
        setPaused(true);
        setActive(index - 1);
      });

      next.addEventListener("click", function () {
        setPaused(true);
        setActive(index + 1);
      });

      dots.forEach((dot, i) => {
        dot.addEventListener("click", function () {
          setPaused(true);
          setActive(i);
        });
      });

      if (carouselToggle) {
        carouselToggle.addEventListener("click", function () {
          setPaused(!isPaused);
        });
      }

      window.addEventListener("planteller-settings-change", function (event) {
        if (event.detail && event.detail.motion === "reduced") {
          setPaused(true);
        }
      });

      carousel.addEventListener("keydown", function (event) {
        if (lightbox && !lightbox.hidden) return;
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          setPaused(true);
          setActive(index - 1);
        }
        if (event.key === "ArrowRight") {
          event.preventDefault();
          setPaused(true);
          setActive(index + 1);
        }
        if (event.key === "Home") {
          event.preventDefault();
          setPaused(true);
          setActive(0);
        }
        if (event.key === "End") {
          event.preventDefault();
          setPaused(true);
          setActive(slides.length - 1);
        }
      });

      function openLightbox(image, zoomButton) {
        if (!lightbox || !lightboxImage) return;
        lastZoomButton = zoomButton;
        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt;
        lightbox.hidden = false;
        document.body.classList.add("lightbox-open");
        setPageInert(true);
        setActive(index);
        setPaused(true);
        if (lightboxNext) lightboxNext.focus();
      }

      function closeLightbox() {
        if (!lightbox || !lightboxImage || lightbox.hidden) return;
        lightbox.hidden = true;
        lightboxImage.src = "";
        lightboxImage.alt = "";
        document.body.classList.remove("lightbox-open");
        setPageInert(false);
        if (lastZoomButton) lastZoomButton.focus();
      }

      function setPageInert(isInert) {
        document.querySelectorAll("header, footer, main > section:not(#impressions)").forEach((element) => {
          if (isInert) {
            element.setAttribute("inert", "");
            element.setAttribute("aria-hidden", "true");
          } else {
            element.removeAttribute("inert");
            element.removeAttribute("aria-hidden");
          }
        });
      }

      function updateLightboxImage() {
        if (!lightbox || !lightboxImage || lightbox.hidden) return;
        const currentImage = slides[index].querySelector("img");
        if (!currentImage) return;
        lightboxImage.src = currentImage.currentSrc || currentImage.src;
        lightboxImage.alt = currentImage.alt;
      }

      function moveLightbox(step) {
        setPaused(true);
        setActive(index + step);
        updateLightboxImage();
      }

      slides.forEach((slide) => {
        const zoomButton = slide.querySelector(".carousel-zoom");
        const image = slide.querySelector("img");
        if (!zoomButton || !image) return;
        zoomButton.addEventListener("click", function () {
          openLightbox(image, zoomButton);
          resetTimer();
        });
      });

      lightboxCloseButtons.forEach((button) => {
        button.addEventListener("click", closeLightbox);
      });

      if (lightboxPrev) {
        lightboxPrev.addEventListener("click", function () {
          moveLightbox(-1);
        });
      }

      if (lightboxNext) {
        lightboxNext.addEventListener("click", function () {
          moveLightbox(1);
        });
      }

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeLightbox();
        if (lightbox && !lightbox.hidden && event.key === "ArrowLeft") {
          event.preventDefault();
          moveLightbox(-1);
        }
        if (lightbox && !lightbox.hidden && event.key === "ArrowRight") {
          event.preventDefault();
          moveLightbox(1);
        }
        if (event.key === "Tab" && lightbox && !lightbox.hidden) {
          const focusable = Array.from(lightbox.querySelectorAll("button:not([tabindex='-1']), [href], [tabindex]:not([tabindex='-1'])"))
            .filter((element) => !element.disabled);
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });

      setActive(0);
      setPaused(isPaused);
    })();
  </script>
  <script src="/settings.js" defer></script>
</body>
</html>
