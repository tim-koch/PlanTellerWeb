  <script>
    (function () {
      var reportLink = document.querySelector("[data-report-404]");
      if (!reportLink) return;
      var subject = "PlanTeller Website 404";
      var body = [
        "Ich habe eine nicht gefundene Seite entdeckt:",
        "",
        "URL: " + window.location.href,
        "Referrer: " + (document.referrer || "Direktaufruf / unbekannt")
      ].join("\n");
      reportLink.href = "mailto:kochbuch_app@outlook.de?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
    })();
  </script>
